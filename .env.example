# Copie para .env (que NÃO é versionado) e troque os valores.
POSTGRES_PASSWORD=troque-esta-senha
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_CHAVE_SECRETA=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
# Origem da PWA que pode chamar a API (CORS)
CORS_ORIGEM=http://localhost:8081
